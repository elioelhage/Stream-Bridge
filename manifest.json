{
  "manifest_version": 3,
  "name": "Stream Bridge",
  "version": "0.5.0",
  "description": "Detect Twitch ads and show an instant Stream Bridge alert.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://www.twitch.tv/*",
    "https://*.twitch.tv/*"
  ],
  "action": {
    "default_title": "Stream Bridge",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.twitch.tv/*"],
      "js": ["src/bridge.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/twitch-detector.js"],
      "matches": ["https://www.twitch.tv/*"]
    }
  ]
}