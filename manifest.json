{
  "manifest_version": 3,
  "name": "StreamSwitch",
  "version": "0.2.0",
  "description": "Switch from a Twitch live stream to a configured YouTube backup while Twitch is showing an ad.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://www.twitch.tv/*",
    "https://*.twitch.tv/*",
    "https://www.youtube.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "StreamSwitch",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.twitch.tv/*"],
      "js": ["src/bridge.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/twitch-detector.js"],
      "matches": ["https://www.twitch.tv/*"]
    }
  ]
}
